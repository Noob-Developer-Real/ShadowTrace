# Copy values into the service manager/secret manager used for your deployment.
ST_MODE=production
ST_ORIGIN=https://trace.example.com
ST_DATABASE_URL=postgresql://shadowtrace_app:REPLACE@db.example.com:5432/shadowtrace?sslmode=verify-full
ST_SESSION_SECRET=REPLACE_WITH_RANDOM_URLSAFE_SECRET
ST_OIDC_ISSUER=https://identity.example.com
ST_OIDC_CLIENT_ID=REPLACE
ST_OIDC_CLIENT_SECRET=REPLACE
# Configure only the reverse proxy that connects directly to Uvicorn.
ST_TRUSTED_PROXY=127.0.0.1

# Optional managed cloud sharing. Use a private versioned bucket and workload IAM role.
# ST_SHARE_S3_BUCKET=
# AWS_DEFAULT_REGION=
